{
  "name": "@tetherto/miningos-wrk-powermeter-abb",
  "version": "1.1.0",
  "description": "MiningOS Worker PowerMeter ABB",
  "keywords": [
    "tether"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/miningos-wrk-powermeter-abb.git"
  },
  "homepage": "https://github.com/tetherto/miningos-wrk-powermeter-abb#readme",
  "bugs": {
    "url": "https://github.com/tetherto/miningos-wrk-powermeter-abb/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "worker.js",
    "workers/",
    "mock/"
  ],
  "main": "worker.js",
  "type": "commonjs",
  "bin": {
    "miningos-wrk-powermeter-abb": "worker.js"
  },
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "npm run lint && npm run test:unit && npm run test:integration",
    "test:unit": "brittle tests/unit/*.js",
    "test:integration": "NODE_ENV=test brittle ./tests/powermeter.test.js",
    "test:coverage": "brittle --coverage tests/{,**/}*.test.js"
  },
  "dependencies": {
    "@bitfinex/bfx-svc-boot-js": "1.3.1",
    "@bitfinex/lib-js-util-promise": "^1.1.0",
    "@tetherto/miningos-tpl-wrk-powermeter": "git+https://github.com/tetherto/miningos-tpl-wrk-powermeter.git",
    "@tetherto/svc-facs-modbus": "^0.1.1",
    "async": "3.2.6"
  },
  "devDependencies": {
    "@tetherto/miningos-mock-control-service": "git+https://github.com/tetherto/miningos-mock-control-service.git",
    "brittle": "3.16.3",
    "debug": "4.4.1",
    "modbus-stream": "0.46.0",
    "standard": "17.1.2",
    "uuid": "14.0.1"
  },
  "overrides": {
    "serialport": "npm:noop@1.0.0"
  }
}
